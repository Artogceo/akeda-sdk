  "catalog_version": 1,
  "extension_points": [
    {
      "key": "core.document_lifecycle.v1",
      "model": "async",
      "owner": "core",
      "request_schema": "core.document_event.v1",
      "response_schema": "platform.delivery_ack.v1",
      "scopes": [
        "core:read"
      ],
      "summary": "Подписка на жизненный цикл документа: создан, обновлён, проведён, отменён, помечен удалённым"
    },
    {
      "errors": [
        "transaction_not_found",
        "directory_mismatch",
        "directory_entry_unknown",
        "confidence_out_of_range",
        "explanation_incomplete",
        "transaction_already_classified"
      ],
      "key": "finance.classification_provider.v1",
      "model": "async",
      "owner": "finance",
      "request_schema": "finance.classification_request.v1",
      "request_topic": "finance.transaction.uncategorized.v1",
      "response_operation": "appFinanceSuggestTransactionClassification",
      "response_schema": "finance.classification_suggestion.v1",
      "scopes": [
        "finance:read",
        "core:read",
        "finance:suggest"
      ],
      "summary": "Поставщик классификации операции: статья и контрагент приходят рекомендацией, которую оператор принимает или отклоняет"
    },
    {
      "key": "platform.context_action.v1",
      "model": "sync",
      "owner": "platform",
      "request_schema": "platform.slot_launch.v1",
      "response_schema": "platform.context_action_result.v1",
      "scopes": [],
      "summary": "Контекстное действие: пункт расширения на экране записи, запускаемый по одноразовому токену"
    },
    {
      "key": "platform.embedded_panel.v1",
      "model": "sync",
      "owner": "platform",
      "request_schema": "platform.slot_launch.v1",
      "response_schema": "platform.embedded_panel_descriptor.v1",
      "scopes": [],
      "summary": "Изолированная панель: iframe со своим источником и мостом сообщений по списку разрешённых типов"
    },
    {
      "key": "platform.settings_page.v1",
      "model": "sync",
      "owner": "platform",
      "request_schema": "platform.slot_launch.v1",
      "response_schema": "platform.settings_page_descriptor.v1",
      "scopes": [],
      "summary": "Страница настройки установки: форма по схеме конфигурации из manifest, без значений секретов"
    }
  ],
