{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
